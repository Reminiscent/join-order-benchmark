+-- from the metadata, not from the planner's own row estimates.
+CREATE TABLE ec_r0 (j01 bigint);
+CREATE TABLE ec_r1 (j01 bigint, j12 bigint);
+CREATE TABLE ec_r2 (j12 bigint);
+CREATE TABLE ec_outsider (j01 bigint);
+
+-- Instance "demo": a three-relation chain 0-1-2.
+--   |r0| = 10   |r1| = 10   |r2| = 100000
+--   edge 0-1 selectivity 0.0005 -> C({0,1})   = 10*10*0.0005 = 0.05 (< 1)
+--   edge 1-2 selectivity 0.1    -> C({1,2})   = 10*100000*0.1 = 100000
+--                                  C({0,1,2}) = 500
+-- The first edge's key NDV is 10, so its native equality-clause
+-- selectivity is 0.1.  This deliberately differs from the logical 0.0005
+-- and proves that the provider keeps logical rows separate from Hash stats.
+-- The intermediate {0,1} is below one row.  Clamping it to 1 before the last
+-- join would inflate the three-way answer; carrying the unclamped log keeps
+-- it at the analytic 500 whichever way the join is built.
+INSERT INTO bench.join_order_relation VALUES

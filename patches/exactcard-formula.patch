diff --git a/src/include/optimizer/exactcard.h b/src/include/optimizer/exactcard.h
new file mode 100644
index 00000000000..295a7c86565
--- /dev/null
+++ b/src/include/optimizer/exactcard.h
@@ -0,0 +1,50 @@
+/*-------------------------------------------------------------------------
+ *
+ * exactcard.h
+ *	  Formula cardinality support for join-order benchmarks.
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * src/include/optimizer/exactcard.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef EXACTCARD_H
+#define EXACTCARD_H
+
+#include "nodes/pathnodes.h"
+
+typedef enum ExactCardMode
+{
+	EXACTCARD_OFF,
+	EXACTCARD_FORMULA
+} ExactCardMode;
+
+typedef enum ExactCardAuditMode
+{
+	EXACTCARD_AUDIT_OFF,
+	EXACTCARD_AUDIT_SUMMARY,
+	EXACTCARD_AUDIT_TRACE
+} ExactCardAuditMode;
+
+extern PGDLLIMPORT int exactcard_mode;
+extern PGDLLIMPORT char *exactcard_instance_id;
+extern PGDLLIMPORT int exactcard_audit;
+
+extern void exactcard_set_baserel_size(PlannerInfo *root, RelOptInfo *rel);
+extern double exactcard_set_joinrel_rows(PlannerInfo *root,
+										 RelOptInfo *joinrel,
+										 RelOptInfo *outer_rel,
+										 RelOptInfo *inner_rel,
+										 SpecialJoinInfo *sjinfo,
+										 List *restrictlist,
+										 double native_rows);
+extern double exactcard_get_hashjoin_rows(PlannerInfo *root, HashPath *path,
+										  double innerbucketsize,
+										  double innermcvfreq,
+										  int numbuckets, int numbatches,
+										  bool bucket_stats_computed);
+extern Datum exactcard_last_audit(PG_FUNCTION_ARGS);
+
+#endif							/* EXACTCARD_H */
diff --git a/src/test/regress/expected/exactcard.out b/src/test/regress/expected/exactcard.out
new file mode 100644
index 00000000000..e56b66541c6
--- /dev/null
+++ b/src/test/regress/expected/exactcard.out
@@ -0,0 +1,265 @@
+--
+-- exactcard: formula cardinality provider for join-order benchmarks
+--
+-- Proves the four things the benchmark relies on:
+--   1. off mode leaves planning unchanged;
+--   2. formula mode injects the analytic product-form cardinality, carried
+--      unclamped between join levels so the result is order-independent;
+--   3. the audit function reports the injected values for the qualification
+--      gate; and
+--   4. unsupported input fails closed.
+--
+-- Metadata tables mirror the benchmark's bench.join_order_* contract.
+CREATE SCHEMA bench;
+CREATE TABLE bench.join_order_relation (
+	instance_id		text,
+	canonical_id	int,
+	relation		regclass,
+	base_rows		float8,
+	base_pages		bigint
+);
+CREATE TABLE bench.join_order_edge (
+	instance_id		text,
+	left_id			int,
+	right_id		int,
+	-- Only fields consumed by the formula provider follow.
+	left_key_ndv	bigint,
+	right_key_ndv	bigint,
+	selectivity		float8
+);
+-- Empty join tables.  No data is loaded: formula mode takes cardinalities
+-- from the metadata, not from the planner's own row estimates.
+CREATE TABLE ec_r0 (j01 bigint);
+CREATE TABLE ec_r1 (j01 bigint, j12 bigint);
+CREATE TABLE ec_r2 (j12 bigint);
+CREATE TABLE ec_outsider (j01 bigint);
+-- Instance "demo": a three-relation chain 0-1-2.
+--   |r0| = 10   |r1| = 10   |r2| = 100000
+--   edge 0-1 selectivity 0.0005 -> C({0,1})   = 10*10*0.0005 = 0.05 (< 1)
+--   edge 1-2 selectivity 0.1    -> C({1,2})   = 10*100000*0.1 = 100000
+--                                  C({0,1,2}) = 500
+-- The first edge's key NDV is 10, so its native equality-clause
+-- selectivity is 0.1.  This deliberately differs from the logical 0.0005
+-- and proves that the provider keeps logical rows separate from Hash stats.
+-- The intermediate {0,1} is below one row.  Clamping it to 1 before the last
+-- join would inflate the three-way answer; carrying the unclamped log keeps
+-- it at the analytic 500 whichever way the join is built.
+INSERT INTO bench.join_order_relation VALUES
+	('demo', 0, 'ec_r0'::regclass, 10, 3),
+	('demo', 1, 'ec_r1'::regclass, 10, 5),
+	('demo', 2, 'ec_r2'::regclass, 100000, 700);
+INSERT INTO bench.join_order_edge VALUES
+	('demo', 0, 1, 10, 10, 0.0005),
+	('demo', 1, 2, 10, 10, 0.1);
+-- Helper: top-plan estimated rows, without the unstable cost columns.
+CREATE FUNCTION ec_plan_rows(q text) RETURNS bigint
+LANGUAGE plpgsql AS $$
+DECLARE j jsonb;
+BEGIN
+	EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO j;
+	RETURN (j->0->'Plan'->>'Plan Rows')::bigint;
+END $$;
+-- Hash-only, fixed join order, so plan rows track the chosen cardinalities.
+-- Merge Join is disabled because exactcard does not model pre-filter rows.
+SET enable_mergejoin = off;
+SET enable_nestloop = off;
+SET enable_hashjoin = on;
+SET max_parallel_workers_per_gather = 0;
+SET join_collapse_limit = 1;
+SET from_collapse_limit = 1;
+-- Two syntactic join orders over the same graph: q1 builds the sub-one
+-- intermediate {0,1} first, q2 builds {1,2} first.
+\set q1 'SELECT 1 FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01) JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12'
+\set q2 'SELECT 1 FROM (ec_r1 JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12) JOIN ec_r0 ON ec_r0.j01 = ec_r1.j01'
+-- Off mode: native planning, which ignores the injected metadata and is
+-- reproducible across the two orders.
+SET exactcard.mode = off;
+SELECT ec_plan_rows(:'q1') <> 500			AS off_ignores_metadata,
+	   ec_plan_rows(:'q1') = ec_plan_rows(:'q2')	AS off_reproducible;
+ off_ignores_metadata | off_reproducible 
+----------------------+------------------
+ t                    | t
+(1 row)
+
+-- Formula mode: the analytic cardinality, identical for both join orders.
+SET exactcard.mode = formula;
+SET exactcard.instance_id = 'demo';
+SET exactcard.audit = trace;
+SELECT ec_plan_rows(:'q2') AS formula_q2;
+ formula_q2 
+------------
+        500
+(1 row)
+
+SELECT ec_plan_rows(:'q1') AS formula_q1;
+ formula_q1 
+------------
+        500
+(1 row)
+
+-- LinDP can form disconnected interval inputs.  A tree can then have more
+-- than one edge crossing the final Hash Join split; every edge must be a
+-- Hash clause and the output rows still come from the complete subset.
+\set q_multi 'SELECT 1 FROM (ec_r0 CROSS JOIN ec_r2) JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01 AND ec_r1.j12 = ec_r2.j12'
+SELECT ec_plan_rows(:'q_multi') AS formula_multi_crossing;
+ formula_multi_crossing 
+------------------------
+                    500
+(1 row)
+
+SELECT max((h->>'crossing_count')::int) AS max_crossing_count
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+ max_crossing_count 
+--------------------
+                  2
+(1 row)
+
+-- Plan shape: three empty tables joined by two hash joins.
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01)
+		JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12;
+                    QUERY PLAN                    
+--------------------------------------------------
+ Hash Join
+   Hash Cond: (ec_r2.j12 = ec_r1.j12)
+   ->  Seq Scan on ec_r2
+   ->  Hash
+         ->  Hash Join
+               Hash Cond: (ec_r1.j01 = ec_r0.j01)
+               ->  Seq Scan on ec_r1
+               ->  Hash
+                     ->  Seq Scan on ec_r0
+(9 rows)
+
+-- Audit of the last formula plan (q1).
+SELECT a->>'active'						AS active,
+	   a->>'instance_id'				AS instance_id,
+	   (a->>'join_count')::int			AS join_count,
+	   (a->>'final_rows')::numeric		AS final_rows,
+	   jsonb_array_length(a->'base')	AS base_rels
+FROM (SELECT exactcard_last_audit() AS a) t;
+ active | instance_id | join_count | final_rows | base_rels 
+--------+-------------+------------+------------+-----------
+ true   | demo        |          2 |        500 |         3
+(1 row)
+
+-- Base cardinalities and pages come from the benchmark metadata.
+SELECT (b->>'canonical_id')::int	AS canon,
+	   (b->>'base_rows')::numeric	AS base_rows,
+	   (b->>'base_pages')::int		AS base_pages
+FROM jsonb_array_elements(exactcard_last_audit()->'base') b
+ORDER BY canon;
+ canon | base_rows | base_pages 
+-------+-----------+------------
+     0 |        10 |          3
+     1 |        10 |          5
+     2 |    100000 |        700
+(3 rows)
+
+-- The widest join's hash tuple count matches its injected rows.
+SELECT max((h->>'hashjointuples')::numeric) AS max_hashjointuples
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+ max_hashjointuples 
+--------------------
+                500
+(1 row)
+
+-- Logical edge selectivity drives the oracle, while key NDV remains the
+-- separately recorded Hash-statistics input.
+SELECT bool_or((h->>'edge_selectivity')::float8
+			   <> 1.0 / (h->>'key_ndv')::float8)
+			AS separates_logical_and_domain
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+ separates_logical_and_domain 
+------------------------------
+ t
+(1 row)
+
+-- The three-way join receives the analytic 500 in the provider audit.
+SELECT max((j->>'formula_rows')::numeric)
+		   FILTER (WHERE jsonb_array_length(j->'relations') = 3)	AS formula_rows
+FROM jsonb_array_elements(exactcard_last_audit()->'joins') j;
+ formula_rows 
+--------------
+          500
+(1 row)
+
+-- Fail closed: a relation outside the instance.
+\set VERBOSITY terse
+SET exactcard.audit = off;
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_outsider ON ec_r0.j01 = ec_outsider.j01;
+ERROR:  exactcard: relation "ec_outsider" is not part of instance "demo"
+-- Fail closed: no instance selected.
+SET exactcard.instance_id = '';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01)
+		JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12;
+ERROR:  exactcard: exactcard.instance_id must be set when exactcard.mode is formula
+-- Fail closed: formula mode does not model base filters.
+SET exactcard.instance_id = 'demo';
+EXPLAIN (COSTS OFF) SELECT 1 FROM ec_r0 WHERE j01 = 1;
+ERROR:  exactcard: sampled, filtered, or non-table base relations are not supported
+-- Fail closed: malformed instance (duplicate canonical_id).
+INSERT INTO bench.join_order_relation VALUES
+	('dup', 0, 'ec_r0'::regclass, 10, 1),
+	('dup', 0, 'ec_r1'::regclass, 20, 1);
+SET exactcard.instance_id = 'dup';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+ERROR:  exactcard: duplicate canonical_id 0 for instance "dup"
+-- Fail closed: malformed logical edge selectivity.
+INSERT INTO bench.join_order_relation VALUES
+	('bad_sel', 0, 'ec_r0'::regclass, 10, 1),
+	('bad_sel', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('bad_sel', 0, 1, 10, 10, 0);
+SET exactcard.instance_id = 'bad_sel';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+ERROR:  exactcard: edge selectivity must be finite and in (0, 1]
+-- Fail closed: one relation cannot have multiple canonical ids.
+INSERT INTO bench.join_order_relation VALUES
+	('dup_rel', 0, 'ec_r0'::regclass, 10, 1),
+	('dup_rel', 1, 'ec_r0'::regclass, 20, 1);
+SET exactcard.instance_id = 'dup_rel';
+EXPLAIN (COSTS OFF) SELECT 1 FROM ec_r0;
+ERROR:  exactcard: relation "ec_r0" has multiple canonical ids for instance "dup_rel"
+-- Fail closed: edges use canonical endpoint order.
+INSERT INTO bench.join_order_relation VALUES
+	('bad_edge', 0, 'ec_r0'::regclass, 10, 1),
+	('bad_edge', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('bad_edge', 1, 0, 10, 10, 0.1);
+SET exactcard.instance_id = 'bad_edge';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+ERROR:  exactcard: edge endpoints must satisfy left_id < right_id
+-- Fail closed: duplicate edges are not allowed.
+INSERT INTO bench.join_order_relation VALUES
+	('dup_edge', 0, 'ec_r0'::regclass, 10, 1),
+	('dup_edge', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('dup_edge', 0, 1, 10, 10, 0.1),
+	('dup_edge', 0, 1, 10, 10, 0.1);
+SET exactcard.instance_id = 'dup_edge';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+ERROR:  exactcard: duplicate edge (0, 1) for instance "dup_edge"
+\set VERBOSITY default
+-- Back to off mode: planning is native again, unaffected by the metadata.
+SET exactcard.mode = off;
+RESET exactcard.instance_id;
+RESET exactcard.audit;
+SELECT ec_plan_rows(:'q1') <> 500 AS off_native_again;
+ off_native_again 
+------------------
+ t
+(1 row)
+
+DROP FUNCTION ec_plan_rows(text);
+DROP SCHEMA bench CASCADE;
+NOTICE:  drop cascades to 2 other objects
+DETAIL:  drop cascades to table bench.join_order_relation
+drop cascades to table bench.join_order_edge
+DROP TABLE ec_r0, ec_r1, ec_r2, ec_outsider;

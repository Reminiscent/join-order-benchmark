+	RETURN (j->0->'Plan'->>'Plan Rows')::bigint;
+END $$;
+
+-- Hash-only, fixed join order, so plan rows track the chosen cardinalities.
+-- Merge Join is disabled because exactcard does not model pre-filter rows.
+SET enable_mergejoin = off;
+SET enable_nestloop = off;
+SET enable_hashjoin = on;
+SET max_parallel_workers_per_gather = 0;
+SET join_collapse_limit = 1;
+SET from_collapse_limit = 1;
+
+-- Two syntactic join orders over the same graph: q1 builds the sub-one
+-- intermediate {0,1} first, q2 builds {1,2} first.
+\set q1 'SELECT 1 FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01) JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12'
+\set q2 'SELECT 1 FROM (ec_r1 JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12) JOIN ec_r0 ON ec_r0.j01 = ec_r1.j01'
+
+-- Off mode: native planning, which ignores the injected metadata and is
+-- reproducible across the two orders.
+SET exactcard.mode = off;
+SELECT ec_plan_rows(:'q1') <> 500			AS off_ignores_metadata,
+	   ec_plan_rows(:'q1') = ec_plan_rows(:'q2')	AS off_reproducible;
+
+-- Formula mode: the analytic cardinality, identical for both join orders.
+SET exactcard.mode = formula;
+SET exactcard.instance_id = 'demo';
+SET exactcard.audit = trace;
+SELECT ec_plan_rows(:'q2') AS formula_q2;
+SELECT ec_plan_rows(:'q1') AS formula_q1;
+
+-- LinDP can form disconnected interval inputs.  A tree can then have more
+-- than one edge crossing the final Hash Join split; every edge must be a
+-- Hash clause and the output rows still come from the complete subset.
+\set q_multi 'SELECT 1 FROM (ec_r0 CROSS JOIN ec_r2) JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01 AND ec_r1.j12 = ec_r2.j12'
+SELECT ec_plan_rows(:'q_multi') AS formula_multi_crossing;
+SELECT max((h->>'crossing_count')::int) AS max_crossing_count
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+
+-- Plan shape: three empty tables joined by two hash joins.
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01)
+		JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12;
+
+-- Audit of the last formula plan (q1).
+SELECT a->>'active'						AS active,
+	   a->>'instance_id'				AS instance_id,
+	   (a->>'join_count')::int			AS join_count,
+	   (a->>'final_rows')::numeric		AS final_rows,
+	   jsonb_array_length(a->'base')	AS base_rels
+FROM (SELECT exactcard_last_audit() AS a) t;
+
+-- Base cardinalities and pages come from the benchmark metadata.
+SELECT (b->>'canonical_id')::int	AS canon,
+	   (b->>'base_rows')::numeric	AS base_rows,
+	   (b->>'base_pages')::int		AS base_pages
+FROM jsonb_array_elements(exactcard_last_audit()->'base') b
+ORDER BY canon;
+
+-- The widest join's hash tuple count matches its injected rows.
+SELECT max((h->>'hashjointuples')::numeric) AS max_hashjointuples
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+
+-- Logical edge selectivity drives the oracle, while key NDV remains the
+-- separately recorded Hash-statistics input.
+SELECT bool_or((h->>'edge_selectivity')::float8
+			   <> 1.0 / (h->>'key_ndv')::float8)
+			AS separates_logical_and_domain
+FROM jsonb_array_elements(exactcard_last_audit()->'hashjoins') h;
+
+-- The three-way join receives the analytic 500 in the provider audit.
+SELECT max((j->>'formula_rows')::numeric)
+		   FILTER (WHERE jsonb_array_length(j->'relations') = 3)	AS formula_rows
+FROM jsonb_array_elements(exactcard_last_audit()->'joins') j;
+
+-- Fail closed: a relation outside the instance.
+\set VERBOSITY terse
+SET exactcard.audit = off;
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_outsider ON ec_r0.j01 = ec_outsider.j01;
+
+-- Fail closed: no instance selected.
+SET exactcard.instance_id = '';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM (ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01)
+		JOIN ec_r2 ON ec_r1.j12 = ec_r2.j12;
+
+-- Fail closed: formula mode does not model base filters.
+SET exactcard.instance_id = 'demo';
+EXPLAIN (COSTS OFF) SELECT 1 FROM ec_r0 WHERE j01 = 1;
+
+-- Fail closed: malformed instance (duplicate canonical_id).
+INSERT INTO bench.join_order_relation VALUES
+	('dup', 0, 'ec_r0'::regclass, 10, 1),
+	('dup', 0, 'ec_r1'::regclass, 20, 1);
+SET exactcard.instance_id = 'dup';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+
+-- Fail closed: malformed logical edge selectivity.
+INSERT INTO bench.join_order_relation VALUES
+	('bad_sel', 0, 'ec_r0'::regclass, 10, 1),
+	('bad_sel', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('bad_sel', 0, 1, 10, 10, 0);
+SET exactcard.instance_id = 'bad_sel';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+
+-- Fail closed: one relation cannot have multiple canonical ids.
+INSERT INTO bench.join_order_relation VALUES
+	('dup_rel', 0, 'ec_r0'::regclass, 10, 1),
+	('dup_rel', 1, 'ec_r0'::regclass, 20, 1);
+SET exactcard.instance_id = 'dup_rel';
+EXPLAIN (COSTS OFF) SELECT 1 FROM ec_r0;
+
+-- Fail closed: edges use canonical endpoint order.
+INSERT INTO bench.join_order_relation VALUES
+	('bad_edge', 0, 'ec_r0'::regclass, 10, 1),
+	('bad_edge', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('bad_edge', 1, 0, 10, 10, 0.1);
+SET exactcard.instance_id = 'bad_edge';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+
+-- Fail closed: duplicate edges are not allowed.
+INSERT INTO bench.join_order_relation VALUES
+	('dup_edge', 0, 'ec_r0'::regclass, 10, 1),
+	('dup_edge', 1, 'ec_r1'::regclass, 20, 1);
+INSERT INTO bench.join_order_edge VALUES
+	('dup_edge', 0, 1, 10, 10, 0.1),
+	('dup_edge', 0, 1, 10, 10, 0.1);
+SET exactcard.instance_id = 'dup_edge';
+EXPLAIN (COSTS OFF) SELECT 1
+	FROM ec_r0 JOIN ec_r1 ON ec_r0.j01 = ec_r1.j01;
+\set VERBOSITY default
+
+-- Back to off mode: planning is native again, unaffected by the metadata.
+SET exactcard.mode = off;
+RESET exactcard.instance_id;
+RESET exactcard.audit;
+SELECT ec_plan_rows(:'q1') <> 500 AS off_native_again;
+
+DROP FUNCTION ec_plan_rows(text);
+DROP SCHEMA bench CASCADE;
+DROP TABLE ec_r0, ec_r1, ec_r2, ec_outsider;

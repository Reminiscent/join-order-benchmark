diff --git a/src/backend/optimizer/util/exactcard.c b/src/backend/optimizer/util/exactcard.c
new file mode 100644
index 00000000000..491fc3a5a39
--- /dev/null
+++ b/src/backend/optimizer/util/exactcard.c
@@ -0,0 +1,1051 @@
+/*-------------------------------------------------------------------------
+ *
+ * exactcard.c
+ *	  Formula cardinality provider for join-order benchmarks.
+ *
+ * This is a benchmark-only facility.  When exactcard.mode = formula, the
+ * optimizer stops deriving join-relation row counts from clause statistics
+ * and instead uses a closed-form product oracle loaded from two metadata
+ * tables, bench.join_order_relation and bench.join_order_edge, keyed by the
+ * exactcard.instance_id GUC.
+ *
+ * The instance describes an independent (product-form) query graph: each
+ * base relation has a cardinality |r| (base_rows), and each join edge has an
+ * explicit logical selectivity s.  Its key NDV D separately describes
+ * the native equality statistics used by Hash Join costing.  Under
+ * independence, for any subset S of the relations
+ *
+ *		log |Join(S)| = sum_{r in S} log|r| + sum_{e in E(S)} log s_e
+ *
+ * where E(S) is the set of edges with both endpoints in S.  This is exactly
+ * PostgreSQL's own independence estimate, but computed once from the visible
+ * base numbers rather than accumulated through per-level row estimates.
+ *
+ * Empty benchmark tables also lose restored pg_class rows and pages during
+ * physical-size estimation.  The provider therefore injects generated base
+ * rows and pages before scan paths are built.  For joins, it keeps the
+ * *unclamped* log cardinality in per-RelOptInfo planner state and applies
+ * clamp_row_est only where a value crosses into a consumer: the join
+ * relation's row count and output-sensitive Hash Join tuple counts.
+ * Base scans and join consumers thus read the same generated landscape.
+ * Merge Join is outside this provider because it may need row counts before
+ * remaining join filters are applied.  The benchmark disables it.
+ *
+ * When exactcard.mode = off the injection hooks are never called and planner
+ * behavior is bit-for-bit unchanged.
+ *
+ * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
+ * Portions Copyright (c) 1994, Regents of the University of California
+ *
+ * IDENTIFICATION
+ *	  src/backend/optimizer/util/exactcard.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <math.h>
+
+#include "catalog/pg_class_d.h"
+#include "catalog/pg_type.h"
+#include "executor/spi.h"
+#include "lib/stringinfo.h"
+#include "nodes/parsenodes.h"
+#include "optimizer/exactcard.h"
+#include "optimizer/extendplan.h"
+#include "optimizer/optimizer.h"
+#include "utils/builtins.h"
+#include "utils/fmgrprotos.h"
+#include "utils/hsearch.h"
+#include "utils/json.h"
+#include "utils/lsyscache.h"
+#include "utils/memutils.h"
+
+/* GUC variables (wired up in guc_parameters.dat / guc_tables.c) */
+int			exactcard_mode = EXACTCARD_OFF;
+int			exactcard_audit = EXACTCARD_AUDIT_OFF;
+char	   *exactcard_instance_id = NULL;
+
+/* Keep this in step with clamp_row_est() in costsize.c. */
+#define EXACTCARD_MAXIMUM_ROWCOUNT 1.0e100
+
+/*
+ * Backend-local instance metadata.  One instance is cached at a time; it is
+ * reloaded whenever exactcard.instance_id changes.  All of it lives in
+ * exactcard_meta_cxt so it survives across statements until replaced.
+ */
+typedef struct ExactCardEdge
+{
+	int			left;			/* canonical id of one endpoint */
+	int			right;			/* canonical id of the other endpoint */
+	int64		left_key_ndv;	/* ndistinct at the left endpoint */
+	int64		right_key_ndv;	/* ndistinct at the right endpoint */
+	double		selectivity;	/* logical edge selectivity */
+	double		log_sel;		/* log(selectivity) */
+} ExactCardEdge;
+
+typedef struct ExactCardOidEntry
+{
+	Oid			reloid;			/* hash key: table OID */
+	int			canon;			/* canonical relation id */
+} ExactCardOidEntry;
+
+typedef struct ExactCardMeta
+{
+	char	   *instance_id;
+	int			nrels;
+	double	   *base_rows;		/* [nrels], indexed by canonical id */
+	BlockNumber *base_pages;	/* [nrels], indexed by canonical id */
+	Oid		   *reloid;			/* [nrels], indexed by canonical id */
+	int			nedges;
+	ExactCardEdge *edges;		/* [nedges] */
+	HTAB	   *oid_to_canon;	/* Oid -> ExactCardOidEntry */
+} ExactCardMeta;
+
+/*
+ * Per-RelOptInfo state: the unclamped log cardinality of the subset the rel
+ * represents, plus the set of canonical relation ids it covers (used to find
+ * the edges crossing between two sub-relations).  Allocated in the rel's own
+ * memory context, so it shares the rel's lifetime and cannot outlive it.
+ */
+typedef struct ExactCardRelState
+{
+	double		log_card;		/* unclamped log C(S) */
+	Bitmapset  *canon;			/* canonical ids in this subset */
+} ExactCardRelState;
+
+/*
+ * Audit records for exactcard_last_audit().  Populated during planning into
+ * exactcard_audit_cxt and reset once per top-level planning run.  The detail
+ * captured is governed by exactcard.audit at plan time.
+ */
+typedef struct ExactCardBaseRec
+{
+	int			canon;
+	Oid			reloid;
+	double		base_rows;		/* injected metadata cardinality */
+	BlockNumber base_pages;		/* injected metadata page count */
+} ExactCardBaseRec;
+
+typedef struct ExactCardJoinRec
+{
+	Bitmapset  *relations;
+	Bitmapset  *outer;
+	Bitmapset  *inner;
+	List	   *crossing;		/* of ExactCardEdge * (copied) */
+	double		formula_rows;	/* what we injected (clamped) */
+	double		log_card;		/* unclamped */
+} ExactCardJoinRec;
+
+typedef struct ExactCardHashRec
+{
+	Bitmapset  *relations;
+	Bitmapset  *outer;
+	Bitmapset  *inner;
+	int			crossing_count;
+	int			inner_endpoint;
+	int64		key_ndv;
+	double		edge_selectivity;
+	double		outer_rows;
+	double		inner_rows;
+	double		innerbucketsize;
+	double		innermcvfreq;
+	int			numbuckets;
+	int			numbatches;
+	bool		bucket_stats_computed;
+	double		hashjointuples;
+} ExactCardHashRec;
+
+typedef struct ExactCardAudit
+{
+	char	   *instance_id;
+	int			join_count;
+	int			hashjoin_count;
+	double		final_rows;		/* rows of the widest join seen */
+	int			final_relcount;
+	List	   *bases;			/* of ExactCardBaseRec * */
+	List	   *joins;			/* of ExactCardJoinRec * */
+	List	   *hashjoins;		/* of ExactCardHashRec * */
+} ExactCardAudit;
+
+static int	exactcard_ext_id = -1;
+static bool exactcard_in_lookup = false;
+
+static MemoryContext exactcard_meta_cxt = NULL;
+static ExactCardMeta *exactcard_meta = NULL;
+
+static MemoryContext exactcard_audit_cxt = NULL;
+static ExactCardAudit *exactcard_audit_data = NULL;
+
+
+/*
+ * Make sure our planner extension id has been assigned.
+ */
+static inline void
+exactcard_ensure_ext_id(void)
+{
+	if (exactcard_ext_id < 0)
+		exactcard_ext_id = GetPlannerExtensionId("exactcard");
+}
+
+/*
+ * Load one instance's metadata from the benchmark tables via SPI.
+ *
+ * SPI runs queries, which re-enters the planner; exactcard_in_lookup guards
+ * against that re-entry re-triggering formula work.  The loaded scalars are
+ * copied out of the SPI context into exactcard_meta_cxt so they outlive
+ * SPI_finish().
+ */
+static void
+exactcard_load_meta(const char *instance_id)
+{
+	Oid			argtypes[1] = {TEXTOID};
+	Datum		values[1];
+	bool		connected = false;
+
+	values[0] = CStringGetTextDatum(instance_id);
+
+	if (exactcard_meta_cxt == NULL)
+		exactcard_meta_cxt = AllocSetContextCreate(TopMemoryContext,
+												   "exactcard metadata",
+												   ALLOCSET_SMALL_SIZES);
+	else
+		MemoryContextReset(exactcard_meta_cxt);
+	exactcard_meta = NULL;
+
+	exactcard_in_lookup = true;
+	PG_TRY();
+	{
+		ExactCardMeta *meta;
+		MemoryContext oldcxt;
+		HASHCTL		ctl;
+		bool	   *seen;
+		int			nrels;
+		int			nedges;
+		int			previous_left = -1;
+		int			previous_right = -1;
+
+		if (SPI_connect() != SPI_OK_CONNECT)
+			elog(ERROR, "exactcard: SPI_connect failed");
+		connected = true;
+
+		/* --- base relations --- */
+		if (SPI_execute_with_args("SELECT canonical_id, relation, base_rows, base_pages"
+								  " FROM bench.join_order_relation"
+								  " WHERE instance_id = $1"
+								  " ORDER BY canonical_id",
+								  1, argtypes, values, NULL, true, 0)
+			!= SPI_OK_SELECT)
+			elog(ERROR, "exactcard: could not read bench.join_order_relation");
+
+		nrels = (int) SPI_processed;
+		if (nrels == 0)
+			ereport(ERROR,
+					(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+					 errmsg("exactcard: no relations found for instance \"%s\"",
+							instance_id)));
+
+		oldcxt = MemoryContextSwitchTo(exactcard_meta_cxt);
+		meta = palloc0(sizeof(ExactCardMeta));
+		meta->instance_id = pstrdup(instance_id);
+		meta->nrels = nrels;
+		meta->base_rows = palloc0(nrels * sizeof(double));
+		meta->base_pages = palloc0(nrels * sizeof(BlockNumber));
+		meta->reloid = palloc0(nrels * sizeof(Oid));
+		MemSet(&ctl, 0, sizeof(ctl));
+		ctl.keysize = sizeof(Oid);
+		ctl.entrysize = sizeof(ExactCardOidEntry);
+		ctl.hcxt = exactcard_meta_cxt;
+		meta->oid_to_canon = hash_create("exactcard oid map", nrels, &ctl,
+										 HASH_ELEM | HASH_BLOBS | HASH_CONTEXT);
+		MemoryContextSwitchTo(oldcxt);
+
+		/*
+		 * Track which canonical ids we have seen.  With nrels rows all in [0,
+		 * nrels), rejecting duplicates guarantees a gap-free 0..nrels-1
+		 * mapping, so no base_rows slot is left at its palloc0 zero.
+		 */
+		seen = palloc0(nrels * sizeof(bool));
+
+		for (uint64 i = 0; i < SPI_processed; i++)
+		{
+			HeapTuple	tuple = SPI_tuptable->vals[i];
+			TupleDesc	tupdesc = SPI_tuptable->tupdesc;
+			bool		isnull;
+			int			canon;
+			Oid			reloid;
+			double		base_rows;
+			int64		base_pages;
+			ExactCardOidEntry *oidentry;
+			bool		found;
+
+			canon = DatumGetInt32(SPI_getbinval(tuple, tupdesc, 1, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null canonical_id");
+			reloid = DatumGetObjectId(SPI_getbinval(tuple, tupdesc, 2, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null relation");
+			base_rows = DatumGetFloat8(SPI_getbinval(tuple, tupdesc, 3, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null base_rows");
+			base_pages = DatumGetInt64(SPI_getbinval(tuple, tupdesc, 4, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null base_pages");
+
+			if (canon < 0 || canon >= nrels)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: canonical_id %d out of range for instance \"%s\"",
+								canon, instance_id)));
+			if (seen[canon])
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: duplicate canonical_id %d for instance \"%s\"",
+								canon, instance_id)));
+			seen[canon] = true;
+			if (!isfinite(base_rows) || base_rows <= 0.0)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: base_rows must be finite and greater than zero")));
+			if (base_pages < 1 || base_pages > MaxBlockNumber)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: base_pages out of range for instance \"%s\"",
+								instance_id)));
+
+			meta->base_rows[canon] = base_rows;
+			meta->base_pages[canon] = (BlockNumber) base_pages;
+			meta->reloid[canon] = reloid;
+			oidentry = hash_search(meta->oid_to_canon, &reloid,
+								   HASH_ENTER, &found);
+			if (found)
+			{
+				char	   *relname = get_rel_name(reloid);
+
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: relation \"%s\" has multiple canonical ids for instance \"%s\"",
+								relname ? relname : "?", instance_id)));
+			}
+			oidentry->canon = canon;
+		}
+
+		/* --- edges --- */
+		if (SPI_execute_with_args("SELECT left_id, right_id,"
+								  " left_key_ndv, right_key_ndv, selectivity"
+								  " FROM bench.join_order_edge"
+								  " WHERE instance_id = $1"
+								  " ORDER BY left_id, right_id",
+								  1, argtypes, values, NULL, true, 0)
+			!= SPI_OK_SELECT)
+			elog(ERROR, "exactcard: could not read bench.join_order_edge");
+
+		nedges = (int) SPI_processed;
+		oldcxt = MemoryContextSwitchTo(exactcard_meta_cxt);
+		meta->nedges = nedges;
+		meta->edges = palloc0(Max(nedges, 1) * sizeof(ExactCardEdge));
+		MemoryContextSwitchTo(oldcxt);
+
+		for (uint64 i = 0; i < SPI_processed; i++)
+		{
+			HeapTuple	tuple = SPI_tuptable->vals[i];
+			TupleDesc	tupdesc = SPI_tuptable->tupdesc;
+			bool		isnull;
+			int			left;
+			int			right;
+			int64		left_key_ndv;
+			int64		right_key_ndv;
+			double		selectivity;
+
+			left = DatumGetInt32(SPI_getbinval(tuple, tupdesc, 1, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null left_id");
+			right = DatumGetInt32(SPI_getbinval(tuple, tupdesc, 2, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null right_id");
+			left_key_ndv = DatumGetInt64(SPI_getbinval(tuple, tupdesc, 3, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null left_key_ndv");
+			right_key_ndv = DatumGetInt64(SPI_getbinval(tuple, tupdesc, 4, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null right_key_ndv");
+			selectivity = DatumGetFloat8(SPI_getbinval(tuple, tupdesc, 5, &isnull));
+			if (isnull)
+				elog(ERROR, "exactcard: null selectivity");
+
+			if (left < 0 || left >= nrels || right < 0 || right >= nrels)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: edge endpoint out of range for instance \"%s\"",
+								instance_id)));
+			if (left >= right)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: edge endpoints must satisfy left_id < right_id")));
+			if (left == previous_left && right == previous_right)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: duplicate edge (%d, %d) for instance \"%s\"",
+								left, right, instance_id)));
+			if (left_key_ndv < 1 || right_key_ndv < 1)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: endpoint key NDVs must be >= 1")));
+			if (!isfinite(selectivity) || selectivity <= 0.0 || selectivity > 1.0)
+				ereport(ERROR,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("exactcard: edge selectivity must be finite and in (0, 1]")));
+
+			previous_left = left;
+			previous_right = right;
+			meta->edges[i].left = left;
+			meta->edges[i].right = right;
+			meta->edges[i].left_key_ndv = left_key_ndv;
+			meta->edges[i].right_key_ndv = right_key_ndv;
+			meta->edges[i].selectivity = selectivity;
+			meta->edges[i].log_sel = log(selectivity);
+		}
+
+		SPI_finish();
+		connected = false;
+		exactcard_in_lookup = false;
+
+		exactcard_meta = meta;
+	}
+	PG_CATCH();
+	{
+		if (connected)
+			SPI_finish();
+		exactcard_in_lookup = false;
+		PG_RE_THROW();
+	}
+	PG_END_TRY();
+}
+
+/*
+ * Return the metadata for the currently selected instance, loading or
+ * reloading it as needed.  Fails closed if no instance is selected.
+ */
+static ExactCardMeta *
+exactcard_ensure_meta(void)
+{
+	const char *instance_id = exactcard_instance_id ? exactcard_instance_id : "";
+
+	if (instance_id[0] == '\0')
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+				 errmsg("exactcard: exactcard.instance_id must be set when exactcard.mode is formula")));
+
+	if (exactcard_meta == NULL ||
+		strcmp(exactcard_meta->instance_id, instance_id) != 0)
+		exactcard_load_meta(instance_id);
+
+	return exactcard_meta;
+}
+
+/*
+ * Map a range-table index to a canonical relation id, failing closed if the
+ * rel is not a plain table belonging to the instance.
+ */
+static int
+exactcard_canon_of_relid(PlannerInfo *root, ExactCardMeta *meta, int relid)
+{
+	RangeTblEntry *rte = root->simple_rte_array[relid];
+	ExactCardOidEntry *oidentry;
+	bool		found;
+
+	if (rte == NULL || rte->rtekind != RTE_RELATION || !OidIsValid(rte->relid))
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: range-table entry %d is not a plain table",
+						relid)));
+
+	oidentry = hash_search(meta->oid_to_canon, &rte->relid, HASH_FIND, &found);
+	if (!found)
+	{
+		char	   *relname = get_rel_name(rte->relid);
+
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+				 errmsg("exactcard: relation \"%s\" is not part of instance \"%s\"",
+						relname ? relname : "?", meta->instance_id)));
+	}
+	return oidentry->canon;
+}
+
+/*
+ * Compute a rel's unclamped log cardinality directly from base metadata over
+ * its relids, and cache it in the rel.  Works for base rels (a single member,
+ * no internal edges) and, as a fallback, for any join rel.
+ */
+static ExactCardRelState *
+exactcard_compute_relstate(PlannerInfo *root, ExactCardMeta *meta,
+						   RelOptInfo *rel)
+{
+	MemoryContext relcxt = GetMemoryChunkContext(rel);
+	MemoryContext oldcxt = MemoryContextSwitchTo(relcxt);
+	ExactCardRelState *st = palloc0(sizeof(ExactCardRelState));
+	Bitmapset  *canon = NULL;
+	double		log_card = 0.0;
+	int			relid = -1;
+	int			c = -1;
+
+	while ((relid = bms_next_member(rel->relids, relid)) >= 0)
+		canon = bms_add_member(canon, exactcard_canon_of_relid(root, meta, relid));
+	st->canon = canon;
+	MemoryContextSwitchTo(oldcxt);
+
+	while ((c = bms_next_member(canon, c)) >= 0)
+		log_card += log(meta->base_rows[c]);
+	for (int i = 0; i < meta->nedges; i++)
+	{
+		if (bms_is_member(meta->edges[i].left, canon) &&
+			bms_is_member(meta->edges[i].right, canon))
+			log_card += meta->edges[i].log_sel;
+	}
+	st->log_card = log_card;
+
+	SetRelOptInfoExtensionState(rel, exactcard_ext_id, st);
+	return st;
+}
+
+/*
+ * Record one base relation into the audit buffer (summary detail or above).
+ */
+static void
+exactcard_audit_base(ExactCardMeta *meta, int canon)
+{
+	MemoryContext oldcxt;
+	ExactCardBaseRec *rec;
+
+	if (exactcard_audit_data == NULL || exactcard_audit < EXACTCARD_AUDIT_SUMMARY)
+		return;
+
+	oldcxt = MemoryContextSwitchTo(exactcard_audit_cxt);
+	rec = palloc0(sizeof(ExactCardBaseRec));
+	rec->canon = canon;
+	rec->reloid = meta->reloid[canon];
+	rec->base_rows = meta->base_rows[canon];
+	rec->base_pages = meta->base_pages[canon];
+	exactcard_audit_data->bases = lappend(exactcard_audit_data->bases, rec);
+	MemoryContextSwitchTo(oldcxt);
+}
+
+/*
+ * Fetch (or lazily compute) a rel's formula state.
+ */
+static ExactCardRelState *
+exactcard_rel_state(PlannerInfo *root, ExactCardMeta *meta, RelOptInfo *rel)
+{
+	ExactCardRelState *st;
+
+	st = GetRelOptInfoExtensionState(rel, exactcard_ext_id);
+	if (st != NULL)
+		return st;
+
+	st = exactcard_compute_relstate(root, meta, rel);
+
+	return st;
+}
+
+/*
+ * Clamp an unclamped log cardinality without overflowing exp().
+ */
+static double
+exactcard_clamp_log_rows(double log_card)
+{
+	Assert(isfinite(log_card));
+
+	if (log_card <= 0.0)
+		return 1.0;
+	if (log_card >= log(EXACTCARD_MAXIMUM_ROWCOUNT))
+		return EXACTCARD_MAXIMUM_ROWCOUNT;
+	return clamp_row_est(exp(log_card));
+}
+
+/*
+ * Reset the audit buffer at the start of each top-level planning run.  The
+ * PlannerGlobal is unique per top-level plan and shared across query levels,
+ * so we use a marker in its extension state to fire this exactly once.
+ */
+static void
+exactcard_audit_begin(PlannerInfo *root)
+{
+	PlannerGlobal *glob = root->glob;
+	MemoryContext oldcxt;
+
+	if (GetPlannerGlobalExtensionState(glob, exactcard_ext_id) != NULL)
+		return;
+
+	if (exactcard_audit_cxt == NULL)
+		exactcard_audit_cxt = AllocSetContextCreate(TopMemoryContext,
+													"exactcard audit",
+													ALLOCSET_SMALL_SIZES);
+	else
+		MemoryContextReset(exactcard_audit_cxt);
+
+	oldcxt = MemoryContextSwitchTo(exactcard_audit_cxt);
+	exactcard_audit_data = palloc0(sizeof(ExactCardAudit));
+	exactcard_audit_data->instance_id =
+		pstrdup(exactcard_meta ? exactcard_meta->instance_id : "");
+	exactcard_audit_data->final_relcount = -1;
+	MemoryContextSwitchTo(oldcxt);
+
+	/* Mark this run; the marker lives with the PlannerGlobal. */
+	SetPlannerGlobalExtensionState(glob, exactcard_ext_id,
+								   MemoryContextAlloc(GetMemoryChunkContext(glob), 1));
+}
+
+/*
+ * Replace the empty table's native base-size estimate with instance metadata.
+ *
+ * This runs after estimate_rel_size() and set_baserel_size_estimates() have
+ * produced PostgreSQL's native values, but before any base paths are built.
+ * Empty benchmark tables otherwise have zero pages and clamp to one row even
+ * when pg_class statistics were restored.  Both rows and pages must therefore
+ * come from the same generated metadata that feeds the subset oracle.
+ */
+void
+exactcard_set_baserel_size(PlannerInfo *root, RelOptInfo *rel)
+{
+	RangeTblEntry *rte;
+	ExactCardMeta *meta;
+	int			canon;
+
+	/* Metadata SPI queries re-enter base-size estimation. */
+	if (exactcard_in_lookup)
+		return;
+
+	exactcard_ensure_ext_id();
+
+	if (rel->reloptkind != RELOPT_BASEREL || rel->rtekind != RTE_RELATION)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: only plain base relations are supported")));
+	rte = root->simple_rte_array[rel->relid];
+	if (rte == NULL || rte->relkind != RELKIND_RELATION ||
+		rte->tablesample != NULL || rel->baserestrictinfo != NIL)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: sampled, filtered, or non-table base relations are not supported")));
+
+	meta = exactcard_ensure_meta();
+	exactcard_audit_begin(root);
+	canon = exactcard_canon_of_relid(root, meta, rel->relid);
+
+	rel->tuples = meta->base_rows[canon];
+	rel->rows = clamp_row_est(meta->base_rows[canon]);
+	rel->pages = meta->base_pages[canon];
+
+	/* Seed unclamped formula state before join relations consume this rel. */
+	(void) exactcard_compute_relstate(root, meta, rel);
+	exactcard_audit_base(meta, canon);
+}
+
+/*
+ * Inject the formula row count for a join relation.
+ *
+ * Called from set_joinrel_size_estimates after PostgreSQL's native estimate.
+ * Compute directly from the joinrel's canonical subset so floating-point
+ * summation order does not depend on the input split that first constructs
+ * the joinrel.
+ */
+double
+exactcard_set_joinrel_rows(PlannerInfo *root, RelOptInfo *joinrel,
+						   RelOptInfo *outer_rel, RelOptInfo *inner_rel,
+						   SpecialJoinInfo *sjinfo, List *restrictlist,
+						   double native_rows)
+{
+	ExactCardMeta *meta;
+	ExactCardRelState *ostate;
+	ExactCardRelState *istate;
+	ExactCardRelState *jstate;
+	MemoryContext oldcxt;
+	double		formula_rows;
+	List	   *crossing = NIL;
+	int			relcount;
+
+	/* Inert while loading metadata (never reached in practice). */
+	if (exactcard_in_lookup)
+		return native_rows;
+
+	exactcard_ensure_ext_id();
+
+	/* Fail closed on anything outside the benchmark inner-join contract. */
+	if (sjinfo == NULL || sjinfo->jointype != JOIN_INNER)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: only inner joins are supported")));
+
+	meta = exactcard_ensure_meta();
+	exactcard_audit_begin(root);
+
+	ostate = exactcard_rel_state(root, meta, outer_rel);
+	istate = exactcard_rel_state(root, meta, inner_rel);
+
+	jstate = exactcard_compute_relstate(root, meta, joinrel);
+	for (int i = 0; i < meta->nedges; i++)
+	{
+		ExactCardEdge *e = &meta->edges[i];
+		bool		l_out = bms_is_member(e->left, ostate->canon);
+		bool		r_out = bms_is_member(e->right, ostate->canon);
+		bool		l_in = bms_is_member(e->left, istate->canon);
+		bool		r_in = bms_is_member(e->right, istate->canon);
+
+		if ((l_out && r_in) || (l_in && r_out))
+		{
+			if (exactcard_audit_data && exactcard_audit >= EXACTCARD_AUDIT_TRACE)
+			{
+				ExactCardEdge *ecopy;
+
+				oldcxt = MemoryContextSwitchTo(exactcard_audit_cxt);
+				ecopy = palloc(sizeof(ExactCardEdge));
+				*ecopy = *e;
+				crossing = lappend(crossing, ecopy);
+				MemoryContextSwitchTo(oldcxt);
+			}
+		}
+	}
+
+	formula_rows = exactcard_clamp_log_rows(jstate->log_card);
+
+	/* Audit. */
+	if (exactcard_audit_data)
+	{
+		exactcard_audit_data->join_count++;
+		relcount = bms_num_members(joinrel->relids);
+		if (relcount > exactcard_audit_data->final_relcount)
+		{
+			exactcard_audit_data->final_relcount = relcount;
+			exactcard_audit_data->final_rows = formula_rows;
+		}
+		if (exactcard_audit >= EXACTCARD_AUDIT_TRACE)
+		{
+			ExactCardJoinRec *rec;
+
+			oldcxt = MemoryContextSwitchTo(exactcard_audit_cxt);
+			rec = palloc0(sizeof(ExactCardJoinRec));
+			rec->relations = bms_copy(jstate->canon);
+			rec->outer = bms_copy(ostate->canon);
+			rec->inner = bms_copy(istate->canon);
+			rec->crossing = crossing;
+			rec->formula_rows = formula_rows;
+			rec->log_card = jstate->log_card;
+			exactcard_audit_data->joins = lappend(exactcard_audit_data->joins, rec);
+			MemoryContextSwitchTo(oldcxt);
+		}
+	}
+
+	return formula_rows;
+}
+
+/*
+ * Supply the Hash Join tuple count from the same subset oracle.
+ *
+ * The join relation was already sized (and cached) by
+ * exactcard_set_joinrel_rows before any path is costed, so hashjointuples,
+ * joinrel->rows, and the hash path's row count read one value; bucket/MCV
+ * inputs remain audit evidence.  The compiler emits one edge-specific
+ * predicate per graph edge, so equal clause and crossing counts prove coverage.
+ */
+double
+exactcard_get_hashjoin_rows(PlannerInfo *root, HashPath *path,
+							double innerbucketsize, double innermcvfreq,
+							int numbuckets, int numbatches,
+							bool bucket_stats_computed)
+{
+	ExactCardMeta *meta;
+	RelOptInfo *joinrel = path->jpath.path.parent;
+	RelOptInfo *outerrel = path->jpath.outerjoinpath->parent;
+	RelOptInfo *innerrel = path->jpath.innerjoinpath->parent;
+	ExactCardRelState *st;
+	ExactCardRelState *outerstate;
+	ExactCardRelState *innerstate;
+	ExactCardEdge *crossing = NULL;
+	int			crossing_count = 0;
+	double		hashjointuples;
+
+	Assert(!exactcard_in_lookup);
+
+	exactcard_ensure_ext_id();
+
+	/* Fail closed on path kinds whose rows would not match the oracle. */
+	if (path->jpath.jointype != JOIN_INNER)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: only inner hash joins are supported")));
+	if (path->jpath.path.param_info != NULL)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: parameterized hash joins are not supported")));
+	if (path->jpath.path.parallel_workers > 0)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: parallel hash joins are not supported")));
+
+	meta = exactcard_ensure_meta();
+	exactcard_audit_begin(root);
+
+	st = exactcard_rel_state(root, meta, joinrel);
+	outerstate = exactcard_rel_state(root, meta, outerrel);
+	innerstate = exactcard_rel_state(root, meta, innerrel);
+	for (int i = 0; i < meta->nedges; i++)
+	{
+		ExactCardEdge *edge = &meta->edges[i];
+		bool		left_outer = bms_is_member(edge->left, outerstate->canon);
+		bool		right_outer = bms_is_member(edge->right, outerstate->canon);
+		bool		left_inner = bms_is_member(edge->left, innerstate->canon);
+		bool		right_inner = bms_is_member(edge->right, innerstate->canon);
+
+		if ((left_outer && right_inner) || (right_outer && left_inner))
+		{
+			crossing_count++;
+			if (crossing == NULL)
+				crossing = edge;
+		}
+	}
+	if (crossing == NULL)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: Hash Join inputs must have a crossing edge")));
+	if (list_length(path->path_hashclauses) != crossing_count)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("exactcard: every crossing edge must be a Hash Join clause")));
+	hashjointuples = exactcard_clamp_log_rows(st->log_card);
+
+	if (exactcard_audit_data)
+	{
+		exactcard_audit_data->hashjoin_count++;
+		if (exactcard_audit >= EXACTCARD_AUDIT_TRACE)
+		{
+			MemoryContext oldcxt = MemoryContextSwitchTo(exactcard_audit_cxt);
+			ExactCardHashRec *rec = palloc0(sizeof(ExactCardHashRec));
+
+			rec->relations = bms_copy(st->canon);
+			rec->outer = bms_copy(outerstate->canon);
+			rec->inner = bms_copy(innerstate->canon);
+			rec->crossing_count = crossing_count;
+			if (crossing_count == 1)
+			{
+				rec->inner_endpoint =
+					bms_is_member(crossing->left, innerstate->canon) ?
+					crossing->left : crossing->right;
+				rec->key_ndv =
+					rec->inner_endpoint == crossing->left ?
+					crossing->left_key_ndv : crossing->right_key_ndv;
+				rec->edge_selectivity = crossing->selectivity;
+			}
+			rec->outer_rows = path->jpath.outerjoinpath->rows;
+			rec->inner_rows = path->jpath.innerjoinpath->rows;
+			rec->innerbucketsize = innerbucketsize;
+			rec->innermcvfreq = innermcvfreq;
+			rec->numbuckets = numbuckets;
+			rec->numbatches = numbatches;
+			rec->bucket_stats_computed = bucket_stats_computed;
+			rec->hashjointuples = hashjointuples;
+			exactcard_audit_data->hashjoins =
+				lappend(exactcard_audit_data->hashjoins, rec);
+			MemoryContextSwitchTo(oldcxt);
+		}
+	}
+
+	return hashjointuples;
+}
+
+/* ---- audit reporting ---- */
+
+/* Emit a finite integer-valued double, or null. */
+static void
+exactcard_json_rows(StringInfo buf, double v)
+{
+	if (isfinite(v))
+		appendStringInfo(buf, "%.0f", v);
+	else
+		appendStringInfoString(buf, "null");
+}
+
+/* Emit a finite double, or null. */
+static void
+exactcard_json_double(StringInfo buf, double v)
+{
+	if (isfinite(v))
+		appendStringInfo(buf, "%.17g", v);
+	else
+		appendStringInfoString(buf, "null");
+}
+
+/* Emit a bitmap of canonical ids as a JSON array, ascending. */
+static void
+exactcard_json_canon(StringInfo buf, Bitmapset *bms)
+{
+	int			m = -1;
+	bool		first = true;
+
+	appendStringInfoChar(buf, '[');
+	while ((m = bms_next_member(bms, m)) >= 0)
+	{
+		if (!first)
+			appendStringInfoChar(buf, ',');
+		appendStringInfo(buf, "%d", m);
+		first = false;
+	}
+	appendStringInfoChar(buf, ']');
+}
+
+/*
+ * exactcard_last_audit() -> jsonb
+ *
+ * Return a structured record of the most recent formula-mode plan, for the
+ * benchmark's estimate-vs-analytic qualification gate.  Detail reflects the
+ * exactcard.audit level that was in effect while that plan was built.
+ */
+Datum
+exactcard_last_audit(PG_FUNCTION_ARGS)
+{
+	StringInfoData buf;
+	ExactCardAudit *a = exactcard_audit_data;
+	Datum		result;
+
+	initStringInfo(&buf);
+
+	if (a == NULL)
+	{
+		appendStringInfoString(&buf, "{\"active\": false}");
+	}
+	else
+	{
+		ListCell   *lc;
+
+		appendStringInfoString(&buf, "{\"active\": true, \"instance_id\": ");
+		escape_json(&buf, a->instance_id);
+		appendStringInfo(&buf, ", \"join_count\": %d", a->join_count);
+		appendStringInfo(&buf, ", \"hashjoin_count\": %d", a->hashjoin_count);
+		appendStringInfoString(&buf, ", \"final_rows\": ");
+		exactcard_json_rows(&buf, a->final_rows);
+
+		if (a->bases != NIL)
+		{
+			bool		first = true;
+
+			appendStringInfoString(&buf, ", \"base\": [");
+			foreach(lc, a->bases)
+			{
+				ExactCardBaseRec *rec = lfirst(lc);
+				char	   *relname = get_rel_name(rec->reloid);
+
+				if (!first)
+					appendStringInfoChar(&buf, ',');
+				appendStringInfo(&buf, "{\"canonical_id\": %d, \"relation\": ",
+								 rec->canon);
+				escape_json(&buf, relname ? relname : "?");
+				appendStringInfoString(&buf, ", \"base_rows\": ");
+				exactcard_json_rows(&buf, rec->base_rows);
+				appendStringInfo(&buf, ", \"base_pages\": %u", rec->base_pages);
+				appendStringInfoChar(&buf, '}');
+				first = false;
+			}
+			appendStringInfoChar(&buf, ']');
+		}
+
+		if (a->joins != NIL)
+		{
+			bool		first = true;
+
+			appendStringInfoString(&buf, ", \"joins\": [");
+			foreach(lc, a->joins)
+			{
+				ExactCardJoinRec *rec = lfirst(lc);
+				ListCell   *lc2;
+				bool		xfirst = true;
+
+				if (!first)
+					appendStringInfoChar(&buf, ',');
+				appendStringInfoString(&buf, "{\"relations\": ");
+				exactcard_json_canon(&buf, rec->relations);
+				appendStringInfoString(&buf, ", \"outer\": ");
+				exactcard_json_canon(&buf, rec->outer);
+				appendStringInfoString(&buf, ", \"inner\": ");
+				exactcard_json_canon(&buf, rec->inner);
+				appendStringInfoString(&buf, ", \"crossing\": [");
+				foreach(lc2, rec->crossing)
+				{
+					ExactCardEdge *e = lfirst(lc2);
+
+					if (!xfirst)
+						appendStringInfoChar(&buf, ',');
+					appendStringInfo(&buf,
+									 "{\"left\": %d, \"right\": %d,"
+									 " \"left_key_ndv\": " INT64_FORMAT
+									 ", \"right_key_ndv\": " INT64_FORMAT,
+									 e->left, e->right,
+									 e->left_key_ndv, e->right_key_ndv);
+					appendStringInfoString(&buf, ", \"selectivity\": ");
+					exactcard_json_double(&buf, e->selectivity);
+					appendStringInfoChar(&buf, '}');
+					xfirst = false;
+				}
+				appendStringInfoString(&buf, "], \"formula_rows\": ");
+				exactcard_json_rows(&buf, rec->formula_rows);
+				appendStringInfoString(&buf, ", \"log_card\": ");
+				exactcard_json_double(&buf, rec->log_card);
+				appendStringInfoChar(&buf, '}');
+				first = false;
+			}
+			appendStringInfoChar(&buf, ']');
+		}
+
+		if (a->hashjoins != NIL)
+		{
+			bool		first = true;
+
+			appendStringInfoString(&buf, ", \"hashjoins\": [");
+			foreach(lc, a->hashjoins)
+			{
+				ExactCardHashRec *rec = lfirst(lc);
+
+				if (!first)
+					appendStringInfoChar(&buf, ',');
+				appendStringInfoString(&buf, "{\"relations\": ");
+				exactcard_json_canon(&buf, rec->relations);
+				appendStringInfoString(&buf, ", \"outer\": ");
+				exactcard_json_canon(&buf, rec->outer);
+				appendStringInfoString(&buf, ", \"inner\": ");
+				exactcard_json_canon(&buf, rec->inner);
+				appendStringInfo(&buf, ", \"crossing_count\": %d",
+								 rec->crossing_count);
+				if (rec->crossing_count == 1)
+				{
+					appendStringInfo(&buf,
+									 ", \"inner_endpoint\": %d, \"key_ndv\": " INT64_FORMAT,
+									 rec->inner_endpoint, rec->key_ndv);
+					appendStringInfoString(&buf, ", \"edge_selectivity\": ");
+					exactcard_json_double(&buf, rec->edge_selectivity);
+				}
+				appendStringInfoString(&buf, ", \"outer_rows\": ");
+				exactcard_json_rows(&buf, rec->outer_rows);
+				appendStringInfoString(&buf, ", \"inner_rows\": ");
+				exactcard_json_rows(&buf, rec->inner_rows);
+				appendStringInfoString(&buf, ", \"innerbucketsize\": ");
+				exactcard_json_double(&buf, rec->innerbucketsize);
+				appendStringInfoString(&buf, ", \"innermcvfreq\": ");
+				exactcard_json_double(&buf, rec->innermcvfreq);
+				appendStringInfo(&buf, ", \"numbuckets\": %d, \"numbatches\": %d",
+								 rec->numbuckets, rec->numbatches);
+				appendStringInfo(&buf, ", \"bucket_stats_computed\": %s",
+								 rec->bucket_stats_computed ? "true" : "false");
+				appendStringInfoString(&buf, ", \"hashjointuples\": ");
+				exactcard_json_rows(&buf, rec->hashjointuples);
+				appendStringInfoChar(&buf, '}');
+				first = false;
+			}
+			appendStringInfoChar(&buf, ']');
+		}
+
+		appendStringInfoChar(&buf, '}');
+	}
+
+	result = DirectFunctionCall1(jsonb_in, CStringGetDatum(buf.data));
+	pfree(buf.data);
+	PG_RETURN_DATUM(result);
+}
